{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-transparent"
  },
  "plugins": ["-opencode.sidebar.context"],
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "tps": true,
    "new_location": "launch",
    "permissions": "autoaccept"
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "speed": 3.25
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 1
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": false
  }
}
