{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [
    "~/.config/opencode/skills/favorite-theme/SKILL.md"
  ],
  "permission": "allow",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "composio": {
      "type": "local",
      "command": ["node", "/Users/raphael/.config/opencode/mcp-servers/composio-mcp.mjs"],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "color": "#00d4ff"
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "file:///Users/raphael/.config/opencode/plugins/notify.ts",
    "opencode-history-search"
  ]
}
