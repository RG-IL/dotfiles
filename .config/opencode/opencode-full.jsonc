{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "small_model": "opencode/big-pickle",
    "instructions": [
        "~/.config/opencode/skills/favorite-theme/SKILL.md"
    ],
    "permission": "allow",
    "mcp": {
        "context7": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@upstash/context7-mcp@latest"
            ],
            "enabled": true
        }
    },
    "agent": {
        "build": {
            "color": "#e9cc94"
        },
        "plan": {
            "color": "#efc0c0"
        }
    },
    "plugin": []
}
