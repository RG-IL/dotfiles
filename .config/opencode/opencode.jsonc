{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "opencode/big-pickle",
  "instructions": [
    "~/.config/opencode/skills/favorite-theme/SKILL.md"
  ],
  "permission": "allow",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "composio": {
      "type": "local",
      "command": ["node", "/Users/raphael/.config/opencode/mcp-servers/composio-mcp.mjs"],
      "enabled": true
    },
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"]
}