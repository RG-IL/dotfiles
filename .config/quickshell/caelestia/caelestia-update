#!/bin/bash
set -euo pipefail

# Rebuild the Qt-linked stack (quickshell, caelestia-shell's QML plugins,
# qt6-m3shapes, qtengine) whenever qt6-base moves underneath it. Without this,
# a Qt update leaves quickshell built against the old Qt and the shell breaks
# on its next restart.
#
# The -git packages build from their paru clones, pinned through a #commit
# fragment injected into the source URL. quickshell follows its newest stable
# tag, so Qt updates move it to releases instead of random master snapshots;
# other -git clones rebuild their current checkout and fall back to master if
# the pinned revision no longer compiles. If a clone is missing (cleared paru
# cache), it is cloned fresh from the AUR and pinned the same way, so recovery
# keeps the same version policy.
#
# Failures are collected in ISSUES and printed as a numbered summary at the
# end, each with the exact command that fixes it, instead of scattered
# WARNING lines that vanish into scrollback.

qt_state="${XDG_CACHE_HOME:-$HOME/.cache}/caelestia-update/qt6-built-against"

ISSUES=()
NOTES=()
add_issue() { ISSUES+=("$1"); }
add_note() { NOTES+=("$1"); } # expected behaviour, printed but not an error

compat_ok() { quickshell --private-check-compat >/dev/null 2>&1; }

# Pull the package names out of makepkg's "==> Missing dependencies:" block
deps_of() {
    awk '/Missing dependencies:/{f=1;next} /^==>/{f=0} f && /^  -> /{sub(/^  -> /,""); printf "%s ", $1}' "$1"
}

last_error() { grep '^==> ERROR' "$1" | tail -1 | cut -c1-120; }

# Record the reason a makepkg invocation failed, with a concrete fix command
note_makepkg_failure() {
    local name=$1 log=$2
    local missing reason
    missing=$(deps_of "$log")
    reason=$(last_error "$log")
    if [[ -n $missing ]]; then
        # makepkg -s already tries to install deps via sudo; getting here means
        # passwordless sudo was not available (or pacman failed mid-install)
        add_issue "$name: missing build dependencies ($missing). Fix: enable passwordless sudo, then run: sudo pacman -S --needed $missing && paru -S --rebuild $name"
    else
        add_issue "$name: makepkg failed${reason:+ ($reason)}. Fix: run: paru -S --rebuild $name"
    fi
}

rebuild_git_clone() {
    local name=$1 dir srcdir sha pkg tag sha_repo build_log
    dir="$HOME/.cache/paru/clone/$name"
    build_log=$(mktemp)

    # Recover the AUR clone if the paru cache was cleared
    if [[ ! -f $dir/PKGBUILD ]]; then
        echo ":: no paru clone for $name; cloning it fresh from the AUR"
        if ! git clone -q "https://aur.archlinux.org/$name.git" "$dir" 2>/dev/null; then
            add_issue "$name: could not clone from the AUR (offline?). Fix: retry when online, or run: paru -S --rebuild $name"
            return 1
        fi
    fi

    # makepkg's working copy: directly in the clone (old layout) or under
    # src/ (pacman >= 6.1 keeps the upstream repo as a bare clone beside it).
    # The AUR repo's own .git is excluded.
    srcdir=$(find "$dir" -type d -name .git -not -path "$dir/.git" -exec dirname {} \; 2>/dev/null | head -1)
    if [[ -z $srcdir ]]; then
        # -s: install missing build deps via sudo instead of failing on them.
        # paru strips -make deps after an install, so a later rebuild always
        # needs some back.
        if ! (cd "$dir" && makepkg -o -s --noconfirm) 2>"$build_log"; then
            note_makepkg_failure "$name" "$build_log"
            return 1
        fi
        srcdir=$(find "$dir" -type d -name .git -not -path "$dir/.git" -exec dirname {} \; 2>/dev/null | head -1)
    fi
    if [[ -z $srcdir ]]; then
        add_issue "$name: could not locate the source checkout. Fix: run: paru -S --rebuild $name"
        return 1
    fi

    # Prefer the bare clone for version lookups: its origin is the real
    # upstream, while a working copy's origin may just be the local bare repo
    sha_repo=$srcdir
    for d in "$dir"/*/; do
        d=${d%/}
        case ${d##*/} in src|pkg) continue ;; esac
        if [[ -f $d/HEAD && ! -d $d/.git ]]; then
            sha_repo=$d
            break
        fi
    done

    if [[ $name == quickshell-git ]]; then
        # Newest stable tag; fall back to the current checkout when offline
        if git -C "$sha_repo" fetch origin --tags -q 2>/dev/null; then
            tag=$(git -C "$sha_repo" tag --sort=-v:refname | grep -E '^v?[0-9]+(\.[0-9]+)+$' | head -1 || true)
        fi
        if [[ -n ${tag:-} ]]; then
            sha=$(git -C "$sha_repo" rev-parse "$tag^{commit}")
        else
            sha=$(git -C "$sha_repo" rev-parse HEAD)
        fi
    else
        sha=$(git -C "$sha_repo" rev-parse HEAD)
    fi

    if grep -q '#commit=' "$dir/PKGBUILD"; then
        sed -i "s|#commit=[0-9a-f]*|#commit=$sha|" "$dir/PKGBUILD"
    else
        sed -i "s|\.git\"|.git#commit=$sha\"|" "$dir/PKGBUILD"
    fi
    grep -q "#commit=$sha" "$dir/PKGBUILD" ||
        echo ":: note: could not pin $name to $sha; building unpinned" >&2

    rm -rf "$srcdir/build"
    if ! (cd "$dir" && makepkg -f -s --noconfirm) 2>"$build_log"; then
        echo ":: pinned revision of $name no longer builds; falling back to master"
        git -C "$sha_repo" checkout -q -B master origin/master 2>/dev/null ||
            git -C "$sha_repo" checkout -q master 2>/dev/null || true
        sed -i 's|#commit=[0-9a-f]*||' "$dir/PKGBUILD"
        rm -rf "$srcdir/build"
        if ! (cd "$dir" && makepkg -f -s --noconfirm) 2>>"$build_log"; then
            note_makepkg_failure "$name" "$build_log"
            return 1
        fi
    fi

    pkg=$(cd "$dir" && ls -t "$name"-*-x86_64.pkg.tar.zst | grep -v -- '-debug-' | head -1 || true)
    if [[ -z $pkg ]]; then
        add_issue "$name: built but no package file was produced. Fix: run: paru -S --rebuild $name"
        return 1
    fi
    if ! sudo pacman -U --noconfirm "$dir/$pkg"; then
        add_issue "$name: built but not installed. Fix: sudo pacman -U $dir/$pkg"
        return 1
    fi
}

ensure_qt_stack() {
    local cur prev="" failed=0
    # Compare only the upstream Qt version, not Arch's pkgrel: a -2 -> -3 bump
    # repackages the same Qt with no ABI change, so it must not trigger a rebuild
    cur=$(pacman -Q qt6-base | awk '{print $2}'); cur=${cur%-*}
    [[ -f $qt_state ]] && prev=$(<"$qt_state") && prev=${prev%-*}

    if [[ $cur == "$prev" ]] && compat_ok; then
        return 0
    fi
    if [[ -z $prev ]] && compat_ok; then
        mkdir -p "${qt_state%/*}"
        printf '%s\n' "$cur" > "$qt_state" # first run with a healthy shell: just record it
        return 0
    fi

    echo ":: qt6-base is now $cur (last built against: ${prev:-unknown}); rebuilding Qt-linked packages"
    rebuild_git_clone quickshell-git || failed=$((failed + 1))
    rebuild_git_clone qt6-m3shapes-git || failed=$((failed + 1))
    paru -S --rebuild caelestia-shell qtengine --noconfirm ||
        { add_issue "caelestia-shell/qtengine rebuild failed. Fix: run: paru -S --rebuild caelestia-shell qtengine"; failed=$((failed + 1)); }

    mkdir -p "${qt_state%/*}"
    if (( failed == 0 )) && compat_ok; then
        printf '%s\n' "$cur" > "$qt_state"
    else
        add_issue "Qt-linked rebuild incomplete; quickshell may break on its next restart. Fix: paru -S --rebuild quickshell-git && caelestia shell -r -d"
        return 1
    fi
}

rebuilt_state="${XDG_CACHE_HOME:-$HOME/.cache}/caelestia-update/rebuilt-soname"

ensure_no_stale_sonames() {
    # Qt is not the only library that can break the shell with an update:
    # any soname bump does (e.g. sndio 1.11 moved libsndio.so.7 -> .9, which
    # broke libcava, linked by caelestia-shell's audio service — the shell
    # then failed to load with "libsndio.so.7: cannot open shared object
    # file"). Such packages are invisible to the version checks above when
    # they have no update of their own. checkrebuild (rebuild-detector)
    # flags every installed package still referencing a stale soname;
    # rebuild the AUR ones here. Official-repo ones can't be rebuilt locally,
    # so just warn — Arch repackages them in its own repos.
    if ! command -v checkrebuild >/dev/null 2>&1; then
        add_issue "rebuild-detector is not installed; stale-soname check skipped. Fix: sudo pacman -S rebuild-detector"
        return 0
    fi

    local stale pkg repo_pkgs
    stale=$(checkrebuild 2>/dev/null) || true
    [[ -n $stale ]] || return 0
    repo_pkgs=$(pacman -Slq 2>/dev/null)

    # checkrebuild prints "<repo>\t<pkgname>"; the repo field is not a package,
    # so take the last field as the name and test membership in the repo list
    while read -r line; do
        [[ -n $line ]] || continue
        pkg=$(awk '{print $NF}' <<<"$line")
        [[ -n $pkg ]] || continue
        if grep -qx "$pkg" <<<"$repo_pkgs"; then
            add_issue "$pkg is an official-repo package linking a stale library. Fix: wait for Arch's rebuild (or ignore if harmless)"
        elif [[ $pkg == quickshell-git ]]; then
            rebuild_git_clone quickshell-git || true
        else
            local ver
            ver=$(pacman -Q "$pkg" | awk '{print $2}')
            mkdir -p "${rebuilt_state%/*}"
            touch "$rebuilt_state"
            if grep -qxF "$pkg $ver" "$rebuilt_state"; then
                # Rebuilding a -bin package from the same prebuilt source never
                # relinks anything: the flag is build-date based and repeats
                # until upstream ships a new binary. Don't redownload for it.
                add_note "$pkg ($ver) still flags as stale; prebuilt package, expected. No action needed if it launches"
                continue
            fi
            echo ":: $pkg links a stale library; rebuilding"
            paru -S --rebuild --noconfirm "$pkg" && {
                newver=$(pacman -Q "$pkg" | awk '{print $2}')
                sed -i "\|^$pkg |d" "$rebuilt_state" # drop outdated entries
                printf '%s\n' "$pkg $newver" >> "$rebuilt_state"
            } || add_issue "$pkg: rebuild failed. Fix: run: paru -S --rebuild $pkg"
        fi
    done <<<"$stale"
}

has_update=$(paru -Qu caelestia-shell 2>/dev/null | head -1) || true

if [[ -n $has_update ]]; then
    # caelestia-shell has an update — caelestia update handles everything
    caelestia update --noconfirm || add_issue "caelestia update failed (exit $?); configs may be out of sync. Fix: re-run the update"
    ~/.config/quickshell/caelestia/sync-upstream.sh || add_issue "sync-upstream.sh failed; fix: run it manually to re-apply /etc/xdg symlinks"
else
    # No caelestia-shell update — use wrapper to prevent quickshell-git from updating
    bindir=$(mktemp -d)
    cat > "$bindir/paru" << 'SCRIPT'
#!/bin/bash
args=()
for arg in "$@"; do
    args+=("$arg")
    [[ "$arg" == "-Syu" ]] && args+=("--ignore" "quickshell-git")
done
exec /usr/bin/paru "${args[@]}"
SCRIPT
    chmod +x "$bindir/paru"
    export PATH="$bindir:$PATH"

    caelestia update --noconfirm || add_issue "caelestia update failed (exit $?); configs may be out of sync. Fix: re-run the update"

    export PATH="${PATH#$bindir:}"
    rm -rf "$bindir"
fi

ensure_qt_stack || true
ensure_no_stale_sonames || true

echo
echo "════════════════════ UPDATE SUMMARY ══════════════════"
if (( ${#ISSUES[@]} == 0 )) && (( ${#NOTES[@]} == 0 )); then
    echo ":: All clear — update finished without problems."
fi
if (( ${#ISSUES[@]} > 0 )); then
    echo ":: ${#ISSUES[@]} issue(s) need attention, in order of occurrence:"
    local_i=1
    for issue in "${ISSUES[@]}"; do
        echo "  $local_i. $issue"
        local_i=$((local_i + 1))
    done
fi
if (( ${#NOTES[@]} > 0 )); then
    echo ":: ${#NOTES[@]} note(s), no action needed:"
    local_i=1
    for note in "${NOTES[@]}"; do
        echo "  $local_i. $note"
        local_i=$((local_i + 1))
    done
fi
echo "══════════════════════════════════════════════════════"

if (( ${#ISSUES[@]} > 0 )); then
    exit 1
fi
exit 0
