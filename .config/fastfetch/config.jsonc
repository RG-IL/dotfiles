{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " : ",
        "constants": [
            "────────────────────────"
        ],
        "key": {
            "paddingLeft": 2
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌{$1}{$1}┐",
            "outputColor": "38;2;242;211;183"
        },
        {
            "type": "title",
            "format": "        {#36} USER{#} : {#35}{user-name}{#} {#34}|{#} {#36}󰍹 HOST{#} : {#35}{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "└{$1}{$1}┘",
            "outputColor": "38;2;242;211;183"
        },
        {
            "type": "custom",
            "format": "{#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#90}     {#91}  {#92}  {#93}  {#94}  {#95}  {#96}  {#97}  {#000000}"
        },
        {
            "type": "custom",
            "format": "┌{$1}{$1}┐",
            "outputColor": "38;2;242;211;183"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": "│ └",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "32"
        },
        {
            "type": "theme",
            "key": "│ ├󰂫",
            "keyColor": "32"
        },
        {
            "type": "icons",
            "key": "│ ├󰂫",
            "keyColor": "32"
        },
        {
            "type": "terminal",
            "key": "│ └",
            "keyColor": "32"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "33"
        },
        {
            "type": "cpu",
            "key": "│ ├󰍛",
            "keyColor": "33"
        },
        {
            "type": "memory",
            "key": "│ ├",
            "keyColor": "33"
        },
        {
            "type": "uptime",
            "key": "│ ├󰅐",
            "keyColor": "33"
        },
        {
            "type": "display",
            "key": "│ └",
            "keyColor": "33"
        },
        {
            "type": "custom",
            "format": "└{$1}{$1}┘",
            "outputColor": "38;2;242;211;183"
        },
        "break",
        {
            "type": "custom",
            "format": "{#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#37}  {#90}     {#91}  {#92}  {#93}  {#94}  {#95}  {#96}  {#97}  {#000000}"
        }
    ]
}
