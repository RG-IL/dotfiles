[Unit]
Description=Watch the caelestia colour scheme for Superwhisper glow sync

[Path]
# Watch the scheme DIRECTORY, not scheme/current.lua itself: caelestia
# replaces that file by rename when the wallpaper changes, and a file watch
# dies (stopping this unit) the moment the watched path is moved away.
PathChanged=%h/.config/hypr/scheme/

[Install]
WantedBy=default.target
