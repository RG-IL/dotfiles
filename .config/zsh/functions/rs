rs() {
    local port="${1:-4444}"
    local cmd="/Users/raphael/JumpGame/penelope-0.21.0/penelope.py"
    local py="/opt/homebrew/bin/python3.11"

    kill_port() {
        local pids=$(lsof -ti tcp:"$1" -sTCP:LISTEN 2>/dev/null)
        [ -z "$pids" ] && return 0

        local names=$(echo "$pids" | xargs -I {} ps -p {} -o comm= 2>/dev/null | xargs -I {} basename "{}")
        echo -e "\033[1;31m[!] Killing: $names\033[0m"

        kill -TERM $pids 2>/dev/null
        sleep 0.2

        pids=$(lsof -ti tcp:"$1" -sTCP:LISTEN 2>/dev/null)
        if [ -n "$pids" ]; then
            kill -9 $pids 2>/dev/null
            sleep 0.05
        fi
    }

    trap 'kill_port $port' EXIT INT TERM QUIT

    local check=$(lsof -ti tcp:"$port" -sTCP:LISTEN 2>/dev/null)
    if [ -n "$check" ]; then
        kill_port "$port"
        echo -e "\033[1;31m[-] Port $port still occupied\033[0m"
        return 1
    fi

    echo -e "\033[1;33m[+] Starting Penelope on port $port...\033[0m"
    "$py" "$cmd" -p "$port"
}
