function y() {
	local tmp cwd target

	tmp="$(mktemp -t yazi-cwd.XXXXXX)"

	if [[ -n "$1" ]]; then
		if [[ -d "$1" ]]; then
			target="$1"
		else
			target="$(zoxide query -- "$1" 2>/dev/null)"

			if [[ -z "$target" ]]; then
				echo "zoxide: no match found for '$1'"
				rm -f -- "$tmp"
				return 1
			fi
		fi
	fi

	local effective_target="${target:-$PWD}"
	if [[ "$effective_target" == "$HOME/dotfiles" || "$effective_target" == "$HOME/dotfiles/"* ]]; then
		local conf
		conf="$(mktemp -d)"
		mkdir -p "$conf/yazi"
		for f in keymap.toml theme.toml init.lua package.toml; do
			[[ -f ~/.config/yazi/$f ]] && ln -s ~/.config/yazi/$f "$conf/yazi/$f"
		done
		[[ -d ~/.config/yazi/plugins ]] && ln -s ~/.config/yazi/plugins "$conf/yazi/plugins"
		sed 's/show_hidden = false/show_hidden = true/' ~/.config/yazi/yazi.toml > "$conf/yazi/yazi.toml"
		XDG_CONFIG_HOME="$conf" command yazi "${target:+$target}" --cwd-file="$tmp"
		rm -rf "$conf"
	else
		command yazi "${target:+$target}" --cwd-file="$tmp"
	fi

	if [[ -f "$tmp" ]]; then
		cwd="$(cat "$tmp")"

		if [[ -n "$cwd" && "$cwd" != "$PWD" && -d "$cwd" ]]; then
			cd "$cwd"
		fi
	fi

	rm -f -- "$tmp"
}
