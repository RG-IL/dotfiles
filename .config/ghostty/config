# Always Start to maximize. 
maximize = true
app-notifications = no-clipboard-copy
keybind = shift+insert=paste_from_clipboard
window-save-state = never
confirm-close-surface = false
quit-after-last-window-closed = true
foreground = #F2D5CF
font-family = "CaskaydiaCove Nerd Font"
font-style = Italic
theme = Catppuccin Frappe
font-size = 12
background-opacity = 0.4
background-blur = 5
mouse-hide-while-typing = true
window-decoration = auto
window-padding-balance = true
window-padding-x = 12
window-padding-y = 12
font-thicken = false
adjust-underline-position = 4
focus-follows-mouse = false
cursor-style = bar
mouse-hide-while-typing = true
custom-shader = $HOME/.config/ghostty/shader/cursor_warp.glsl
# custom-shader = $HOME/.config/ghostty/shader/ripple_cursor.glsl
# custom-shader = $HOME/.config/ghostty/shader/x.glsl
custom-shader = $HOME/.config/ghostty/shader/grain.glsl
custom-shader-animation = true
window-inherit-working-directory = false
env = LANG=en_US.UTF-8

