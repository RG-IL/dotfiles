#!/bin/bash

# Adapted from omarchy-menu-keybindings: emit TSV (chord, description, command)
# for every active Hyprland bind. Consumed by the in-launcher keybindings list.

set -euo pipefail

hyprctl binds -j | jq -r '
  def modname(m):
    if m == 0 then ""
    else
      ((if (m / 64 | floor) % 2 == 1 then "SUPER+SHIFT+" else "" end) +
       (if (m / 8 | floor) % 2 == 1 then "SUPER+CTRL+" else "" end) +
       (if (m / 4 | floor) % 2 == 1 then "ALT+" else "" end) +
       (if (m / 2 | floor) % 2 == 1 then "SHIFT+" else "" end) +
       (if m % 2 == 1 then "SUPER+" else "" end))
    end;
  .[]
  | select(.flag != "l") # ignore long-press-only binds
  | [modname(.modmask), .key]
  | @tsv
' | awk -F'\t' '
  {
    chord = $1 $2
    print chord "\t" chord "\t"
  }'
