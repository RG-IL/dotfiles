#!/bin/bash

# caelestia-menu:summary=Launch a TUI command in the default terminal with Omarchy styling
# caelestia-menu:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  shift
else
  APP_ID="TUI.$(basename "$1")"
fi

exec setsid ghostty --class=$APP_ID -e "$1" "${@:2}"
