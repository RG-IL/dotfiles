#!/bin/bash

# Simple system info window (About). No menu branding here — just system info.

exec setsid ghostty --class="org.caelestia.about" --title="About" --window-height=34 --window-width=110 -e bash -c 'clear; fastfetch; echo; echo -n "Press any key to close..."; read -n 1 -s; menu-show-done'
