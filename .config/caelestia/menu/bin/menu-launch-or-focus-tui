#!/bin/bash

# caelestia-menu:summary=Launch a TUI or focus an existing terminal window for it
# caelestia-menu:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="TUI.$(basename "$1")"
fi

LAUNCH_COMMAND="menu-launch-tui $@"

exec menu-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
