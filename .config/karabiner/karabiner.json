{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Right Command + hjkl to arrow keys",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "h",
                                    "modifiers": {
                                        "mandatory": ["right_command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "left_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "j",
                                    "modifiers": {
                                        "mandatory": ["right_command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "down_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "k",
                                    "modifiers": {
                                        "mandatory": ["right_command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "up_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "l",
                                    "modifiers": {
                                        "mandatory": ["right_command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "right_arrow" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Cmd+Shift+J/K to adjust Ghostty blur (hold to repeat)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "j",
                                    "modifiers": {
                                        "mandatory": ["left_command", "shift"]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "$HOME/.config/ghostty/scripts/decrease-blur-loop.sh &>/dev/null &"
                                    }
                                ],
                                "to_after_key_up": [
                                    {
                                        "shell_command": "$HOME/.config/ghostty/scripts/stop-blur.sh"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "k",
                                    "modifiers": {
                                        "mandatory": ["left_command", "shift"]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "$HOME/.config/ghostty/scripts/increase-blur-loop.sh &>/dev/null &"
                                    }
                                ],
                                "to_after_key_up": [
                                    {
                                        "shell_command": "$HOME/.config/ghostty/scripts/stop-blur.sh"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Opt+Shift+J/K to adjust Ghostty opacity (hold to repeat)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "j",
                                    "modifiers": {
                                        "mandatory": ["left_option", "shift"]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "$HOME/.config/ghostty/scripts/decrease-opacity-loop.sh &>/dev/null &"
                                    }
                                ],
                                "to_after_key_up": [
                                    {
                                        "shell_command": "$HOME/.config/ghostty/scripts/stop-blur.sh"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "k",
                                    "modifiers": {
                                        "mandatory": ["left_option", "shift"]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "$HOME/.config/ghostty/scripts/increase-opacity-loop.sh &>/dev/null &"
                                    }
                                ],
                                "to_after_key_up": [
                                    {
                                        "shell_command": "$HOME/.config/ghostty/scripts/stop-blur.sh"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}