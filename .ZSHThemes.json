{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "console_title_template": "{{ if .Root }}root @ {{ end }}{{ .Shell }} in {{ .Folder }}",
    "blocks": [
        {
            "alignment": "left",
            "segments": [
                {
                    "foreground": "#eebebe",
                    "style": "plain",
                    "template": " <#f4b8e4>{{ .PWD }}</> ",
                    "type": "text"
                },
                {
                    "foreground": "#a6d189",
                    "foreground_templates": [
                        "{{ if or (.Working.Changed) (.Staging.Changed) }}#ef9f76{{ end }}",
                        "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ef9f76{{ end }}",
                        "{{ if gt .Ahead 0 }}#f4b8e4{{ end }}",
                        "{{ if gt .Behind 0 }}#f4b8e4{{ end }}"
                    ],
                    "options": {
                        "branch_icon": "\ue725 ",
                        "fetch_status": true,
                        "fetch_upstream_icon": true
                    },
                    "style": "plain",
                    "template": "<#f2d5cf>::❯</> {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#81c8be> \uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
                    "type": "git"
                },
                {
                    "foreground": "#f2d5cf",
                    "style": "plain",
                    "template": "\u276f ",
                    "type": "text"
                }
            ],
            "type": "prompt"
        }
    ],
    "osc99": true,
    "transient_prompt": {
        "background": "transparent",
        "foreground": "#eebebe",
        "template": " <#f4b8e4>{{ .PWD }}</> <#f2d5cf>\u276f</> "
    },
    "secondary_prompt": {
        "background": "transparent",
        "foreground": "#f4b8e4",
        "template": "\u2570\u2500\u276f "
    },
    "version": 4
}
