# /etc/xdg symlinks managed by sync-upstream.sh; only real overrides are tracked
.config/quickshell/caelestia-local/modules/dashboard/*.qml
.config/quickshell/caelestia-local/modules/dashboard/dash
.config/quickshell/caelestia-local/modules/dashboard/media
.config/quickshell/caelestia-local/modules/dashboard/performance
# daily driver: symlink to the caelestia-shell PR checkout (see setup.sh / README)
.config/quickshell/caelestia
.config/nvim/lazy-lock.json
# runtime file toggling the default AI assistant in nvim
.config/nvim/.ai_default
# scheme files regenerated on every theme apply; re-apply a scheme to recreate
.config/btop/themes/caelestia.theme
.config/hypr/scheme/current.conf
.config/hypr/scheme/current.lua
bindings.superwhisper-*.bak
